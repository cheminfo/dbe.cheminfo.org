# Copy this file to .env.
# Local dev: leave COMPOSE_FILE commented, then npm run dev (Vite serves on PORT).
# Docker:    uncomment one COMPOSE_FILE line, then docker compose up -d.

# Deployment mode: uncomment exactly ONE line to choose how the service is
# exposed. With none uncommented, docker compose uses compose.yaml by default.
# COMPOSE_FILE=compose.yaml             # port-published (publishes PORT on the host)
# COMPOSE_FILE=compose.traefik.yaml     # behind a Traefik reverse proxy
# COMPOSE_FILE=compose.cloudflared.yaml # behind a Cloudflare Tunnel (no published port)

# The image every compose file runs, and the tag deploy.sh builds, deploys and
# rolls back. Every build gets its own immutable tag, so the previous one stays
# reachable on the host.
IMAGE_NAME=ghcr.io/cheminfo/dbe.cheminfo.org
IMAGE_TAG=latest          # managed by deploy.sh - do not edit by hand

# Host port the site is published on (compose.yaml only). The container itself
# always listens on 80. This number is picked rather than derived from the
# creation date: that date gives 10917, which symmetry.cheminfo.org took the
# same day, and the 106xx block the family falls back to is packed tight enough
# that the next derived candidate was already listening. 10650 was checked
# against every sibling and against the machine. The Vite dev server takes the
# same number, since this site has no backend to leave room for.
PORT=10650

# Where this deployment is mounted. Unset it answers at the root of its own
# host, which is what dbe.cheminfo.org does. A deployment serving the tool
# under a path of a shared host names that path here — the container stamps it
# into every page when it starts, so the SAME image and the SAME tag serve both
# addresses and nothing is rebuilt:
#   BASE_PATH=/dbe/   # for https://www.cheminfo.org/dbe/
# BASE_PATH=/

# The analytics snippet, verbatim, injected at the end of <head> in the pages
# the container serves. Unset, nothing is loaded — which is what a developer's
# checkout and `npm run dev` want. Get this site's own data-website-id from
# https://datami.cheminfo.org; never copy another site's.
# TRACKING_SCRIPT=<script defer src="https://datami.cheminfo.org/script.js" data-website-id="..."></script>

# Cloudflare Tunnel token (compose.cloudflared.yaml only).
# TUNNEL_TOKEN=
